# Enforce consistent line endings
* text=auto

# Force LF for all source code
*.js text eol=lf
*.json text eol=lf
*.sol text eol=lf
*.py text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf

# Windows-specific files (if any)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.avi binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
